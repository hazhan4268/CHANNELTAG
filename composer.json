{
    "name": "telegram-bot/channel-manager",
    "description": "Production-grade Telegram bot for auto-replying to channel posts with admin panel and auto-update system",
    "type": "project",
    "license": "MIT",
    "version": "2.1.0",
    "keywords": ["telegram", "bot", "channel", "manager", "php", "webhook"],
    "homepage": "https://github.com/hazhan4268/CHANNELTAG",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com",
            "homepage": "https://github.com/hazhan4268"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-redis": "For caching and session storage",
        "ext-opcache": "For better performance"
    },
    "autoload": {
        "psr-4": {
            "TelegramBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramBot\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "@composer dump-autoload"
        ],
        "post-update-cmd": [
            "@composer dump-autoload"
        ],
        "test": "phpunit",
        "check": [
            "@composer validate",
            "@composer normalize --dry-run"
        ]
    },
    "support": {
        "issues": "https://github.com/hazhan4268/CHANNELTAG/issues",
        "source": "https://github.com/hazhan4268/CHANNELTAG"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/hazhan4268"
        }
    ]
}
